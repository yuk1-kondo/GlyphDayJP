<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.Title">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Subtitle">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Body">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Small">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Button styles -->
    <style name="Button.Blue">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@color/button_blue</item>
        <item name="android:padding">@dimen/button_padding_vertical</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:layout_margin">@dimen/spacing_small</item>
    </style>

    <style name="Button.Purple">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@color/button_purple</item>
        <item name="android:padding">@dimen/button_padding_vertical</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:layout_margin">@dimen/spacing_small</item>
    </style>
</resources>
